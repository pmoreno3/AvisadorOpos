# Configuración de Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_usuario@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM=tu_usuario@gmail.com
EMAIL_TO=destinatario@gmail.com

# Configuración del Monitor
CHECK_INTERVAL_MINUTES=20
TARGET_URL=https://www.caib.es/oposedu04front/portal/index.do

# Filtros (Formato: CUERPO:ESPECIALIDAD:NOMBRE|CUERPO:ESPECIALIDAD:NOMBRE)
MONITOR_TARGETS=0590:107:Informática|0590:227:Sistemas y aplicaciones informáticas
